/* =========================================================
   MKR — STYLE COMPLET
   ========================================================= */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #0b0b0b;
  color: #f2f0eb;
  font-family: "Work Sans", sans-serif;
  font-weight: 300;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

/* ---------- Grain ---------- */

.grain {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
}

/* ---------- Navigation ---------- */

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;

  height: 92px;
  padding: 18px 5vw;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(11, 11, 11, 0.94);
  backdrop-filter: blur(12px);
}

.nav__logo {
  display: flex;
  align-items: center;
  gap: 18px;
}

.nav__logo-img {
  width: 62px;
  height: 62px;
  object-fit: contain;
}

.nav__logo-sub {
  max-width: 220px;
  color: #aaa59e;
  font-size: 16px;
  line-height: 1.3;
  letter-spacing: 0.05em;
}

.nav__links {
  display: flex;
  align-items: center;
  gap: 32px;
}

.nav__links a {
  color: #aaa59e;
  font-size: 14px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: color 0.2s ease;
}

.nav__links a:hover,
.nav__links a.is-active {
  color: #fff;
}

.nav__toggle {
  display: none;
  width: 48px;
  height: 48px;
  padding: 8px;

  border: 0;
  background: transparent;
}

.nav__toggle span {
  display: block;
  width: 100%;
  height: 2px;
  margin: 6px 0;
  background: #f2f0eb;
}

/* ---------- Pages ---------- */

main {
  min-height: 100vh;
  padding-top: 92px;
}

.view {
  display: none;
  min-height: calc(100vh - 92px);
  padding: 70px 5vw 90px;

  opacity: 0;
  transition: opacity 260ms ease;
}

.view.active {
  display: block;
}

.view.is-visible {
  opacity: 1;
}

/* ---------- Texte général ---------- */

.eyebrow {
  margin: 0 0 18px;
  color: #9a9a92;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

h1,
h2 {
  margin: 0;
  font-family: "Fraunces", serif;
  font-weight: 400;
}

h2 {
  font-size: clamp(42px, 6vw, 78px);
  line-height: 0.95;
}

/* ---------- Images ---------- */

.ph-img {
  position: relative;
  overflow: hidden;
  background: #171717;
}

.ph-img img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ---------- Accueil ---------- */

#accueil {
  padding-top: 55px;
}

.hero {
  max-width: 1250px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: minmax(280px, 1fr) minmax(300px, 0.9fr);
  gap: 7vw;
  align-items: center;
}

.hero__frame {
  width: 100%;
  max-width: 620px;
}

.hero__image {
  width: 100%;
  aspect-ratio: 4 / 5;
}

.hero__text {
  max-width: 560px;
}

.hero__title {
  font-size: clamp(48px, 6vw, 86px);
  line-height: 0.98;
}

.hero__title em {
  color: #aaa59e;
  font-weight: 300;
}

.hero__lead {
  margin: 30px 0;
  max-width: 500px;
  color: #aaa59e;
  font-size: 17px;
  line-height: 1.7;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 48px;
  padding: 0 22px;

  border: 1px solid #777;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: 0.2s ease;
}

.btn--primary {
  background: #f2f0eb;
  color: #0b0b0b;
  border-color: #f2f0eb;
}

.btn--primary:hover {
  background: #aaa59e;
  border-color: #aaa59e;
}

.btn--ghost {
  color: #f2f0eb;
}

.btn--ghost:hover {
  background: #f2f0eb;
  color: #0b0b0b;
}

/* ---------- Thèmes ---------- */

.themes-strip {
  max-width: 1250px;
  margin: 80px auto 0;

  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.theme-tile {
  position: relative;
  height: 240px;
  overflow: hidden;
  background: #171717;
}

.theme-tile__img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.theme-tile:hover .theme-tile__img {
  transform: scale(1.04);
}

.theme-tile__label {
  position: absolute;
  left: 18px;
  bottom: 16px;

  font-family: "Fraunces", serif;
  font-size: 27px;
}

/* ---------- Portfolio ---------- */

.view__head {
  max-width: 1250px;
  margin: 0 auto 35px;
}

.filters {
  max-width: 1250px;
  margin: 0 auto 35px;

  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter {
  padding: 10px 16px;
  border: 1px solid #444;
  background: transparent;
  color: #aaa59e;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.filter:hover,
.filter.is-active {
  background: #f2f0eb;
  color: #0b0b0b;
  border-color: #f2f0eb;
}

.proof-sheet {
  max-width: 1250px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.proof-sheet__item {
  min-width: 0;
  aspect-ratio: 3 / 4;
  cursor: pointer;
}

.proof-sheet__item.is-hidden {
  display: none;
}

.proof-sheet__item .ph-img {
  width: 100%;
  height: 100%;
}

.proof-sheet__item img {
  transition: transform 0.35s ease;
}

.proof-sheet__item:hover img {
  transform: scale(1.03);
}

/* ---------- À propos ---------- */

.about {
  max-width: 1150px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: minmax(280px, 0.8fr) minmax(300px, 1fr);
  gap: 7vw;
  align-items: start;
}

.about__portrait {
  width: 100%;
  aspect-ratio: 4 / 5;
  cursor: pointer;
}

.about__text {
  padding-top: 20px;
}

.about__text h2 {
  margin-bottom: 20px;
}

.about__lead {
  color: #aaa59e;
  font-size: 18px;
}

.about__text p:not(.eyebrow):not(.about__lead) {
  color: #aaa59e;
  font-size: 16px;
  line-height: 1.75;
}

.about__text ul {
  padding: 0;
  margin: 30px 0 0;
  list-style: none;
}

.about__text li {
  padding: 12px 0;
  border-top: 1px solid #333;
  color: #aaa59e;
}

.about__text li span {
  display: inline-block;
  width: 100px;
  color: #f2f0eb;
}

/* ---------- Contact ---------- */

.contact__grid {
  max-width: 1100px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1fr 0.7fr;
  gap: 7vw;
}

.contact__form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.contact__form label {
  display: flex;
  flex-direction: column;
  gap: 8px;

  color: #aaa59e;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.contact__form input,
.contact__form select,
.contact__form textarea {
  width: 100%;
  padding: 14px;

  border: 1px solid #444;
  outline: none;

  background: #111;
  color: #f2f0eb;
}

.contact__form textarea {
  resize: vertical;
}

.contact__form input:focus,
.contact__form select:focus,
.contact__form textarea:focus {
  border-color: #aaa59e;
}

.contact__info ul {
  padding: 0;
  margin: 25px 0;
  list-style: none;
}

.contact__info li {
  padding: 15px 0;
  border-bottom: 1px solid #333;
  color: #aaa59e;
}

.contact__info li span {
  display: block;
  margin-bottom: 5px;
  color: #f2f0eb;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.contact__info a:hover {
  color: #fff;
}

/* ---------- Lightbox ---------- */

.lightbox {
  position: fixed;
  inset: 0;
  z-index: 5000;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 30px;

  background: rgba(0, 0, 0, 0.96);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transition: opacity 0.2s ease;
}

.lightbox.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.lightbox__img {
  display: block;
  max-width: 90vw;
  max-height: 85vh;
  width: auto;
  height: auto;
  object-fit: contain;
}

.lightbox__close {
  position: absolute;
  top: 20px;
  right: 25px;

  border: 0;
  background: transparent;
  color: white;

  font-size: 42px;
  line-height: 1;
}

.lightbox__nav {
  position: absolute;
  top: 50%;

  transform: translateY(-50%);

  width: 55px;
  height: 70px;

  border: 0;
  background: transparent;
  color: white;

  font-size: 55px;
}

.lightbox__nav--prev {
  left: 15px;
}

.lightbox__nav--next {
  right: 15px;
}

.lightbox__caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 25px;

  text-align: center;
  color: #aaa59e;
}

/* ---------- Footer ---------- */

.footer {
  padding: 30px 5vw;
  border-top: 1px solid #222;

  color: #777;
  font-size: 11px;
  text-align: center;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .nav {
    height: 82px;
    padding: 12px 22px;
  }

  .nav__logo {
    gap: 12px;
  }

  .nav__logo-img {
    width: 58px;
    height: 58px;
  }

  .nav__logo-sub {
    max-width: 180px;
    font-size: 14px;
    line-height: 1.25;
  }

  .nav__toggle {
    display: block;
    flex-shrink: 0;
  }

  .nav__links {
    position: absolute;
    top: 82px;
    left: 0;
    right: 0;

    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;

    padding: 8px 22px 20px;

    background: rgba(11, 11, 11, 0.98);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-10px);
    transition: 0.2s ease;
  }

  .nav__links.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav__links a {
    padding: 16px 0;
    border-bottom: 1px solid #292929;
    font-size: 13px;
  }

  main {
    padding-top: 82px;
  }

  .view {
    min-height: calc(100vh - 82px);
    padding: 40px 20px 65px;
  }

  /* Accueil */

  #accueil {
    padding-top: 30px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: stretch;
  }

  .hero__frame {
    max-width: none;
  }

  .hero__image {
    aspect-ratio: 4 / 5;
  }

  .hero__text {
    max-width: none;
  }

  .hero__title {
    font-size: clamp(42px, 12vw, 62px);
  }

  .hero__lead {
    font-size: 15px;
    line-height: 1.65;
    margin: 22px 0;
  }

  .hero__actions {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }

  .themes-strip {
    margin-top: 45px;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .theme-tile {
    height: 180px;
  }

  .theme-tile__label {
    left: 12px;
    bottom: 12px;
    font-size: 22px;
  }

  /* Portfolio */

  h2 {
    font-size: 48px;
  }

  .filters {
    gap: 6px;
    margin-bottom: 25px;
  }

  .filter {
    padding: 9px 11px;
    font-size: 10px;
  }

  .proof-sheet {
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }

  .proof-sheet__item {
    aspect-ratio: 3 / 4;
  }

  /* À propos */

  .about {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .about__portrait {
    width: 100%;
    max-width: 500px;
  }

  .about__text {
    padding-top: 0;
  }

  .about__text p:not(.eyebrow):not(.about__lead) {
    font-size: 15px;
    line-height: 1.7;
  }

  /* Contact */

  .contact__grid {
    display: flex;
    flex-direction: column;
    gap: 45px;
  }

  /* Lightbox */

  .lightbox {
    padding: 15px;
  }

  .lightbox__img {
    max-width: 94vw;
    max-height: 80vh;
  }

  .lightbox__nav {
    width: 40px;
    font-size: 42px;
  }

  .lightbox__nav--prev {
    left: 0;
  }

  .lightbox__nav--next {
    right: 0;
  }

  .lightbox__close {
    top: 12px;
    right: 15px;
    font-size: 36px;
  }
}

/* Très petits téléphones */

@media (max-width: 380px) {

  .nav__logo-sub {
    max-width: 145px;
    font-size: 12px;
  }

  .nav__logo-img {
    width: 52px;
    height: 52px;
  }

  .nav {
    padding-left: 16px;
    padding-right: 16px;
  }

  .view {
    padding-left: 15px;
    padding-right: 15px;
  }

  .hero__title {
    font-size: 40px;
  }

  .themes-strip {
    grid-template-columns: 1fr;
  }

  .theme-tile {
    height: 210px;
  }
}
